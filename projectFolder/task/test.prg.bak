Function cptest
	P1 = XY(0, 0, 50, 90, 180, 0) /1
	P2 = XY(0, 0, 100, 90, 180, 0) /1
	CP On
	Go P1
	Wait 0.5
	Move P2
Fend

Function func
	Tool 1
	Go XY(27, 502, 50, 90, 0, -180)
	
	P1 = XY(0, 0, 0, 180) /1
	Go P1
	P2 = XY(0, 50, 0, 180) /1
    'Jump3 P1 +TLZ(-50), P2 +TLZ(-50), P2 C1
    'CP On
    Move P1 +TLZ(-50)
    Move P2 +TLZ(-50)
    Move P2
Fend

Function inverseTest
	Boolean isOn
	isOn = False
	Do
		If MemSw(0) = 1 And isOn = False Then
			isOn = Not isOn
			Print "OnOnce"
        ElseIf MemSw(0) = 0 Then
        	isOn = False
		EndIf
	Loop
Fend
Function forTest
	TmReset 0
	
	Wait 2
	Print Tmr(0) / 10
Fend

