Integer u, v, w
Function stack_task
	Integer i, scale
	String list$(12)
	Do
		If Sw(0) = 1 Then
			Print 'starting'
			For i = 0 To 11
				If (i Mod 2) = 1 Then
					list$(i) = "Block"
				Else
					list$(i) = "Token"
				EndIf
				Print list$(i)
			Next
			useGUI_stack = False
			scale = 1
			Motor On
			Power High
			Speed 30 / scale
			Accel 30 / scale, 30 / scale
			SpeedS 500 / scale
			AccelS 5000 / scale
			Exit Do
		EndIf
		Print 'waiting'
	Loop
	Double x, y, obj_h
	String type$
	Integer read_i, Token_i, Block_i
	
	obj_h = 6.0
	Token_i = 5
	Block_i = 5
	u = 90
	v = 180
	w = 0
	
	Go XY(31, 24, 130, u, v, w) /1
	For read_i = 0 To 11
		Move XY(31, 24, 100, u, v, w) /1
		type$ = list$(read_i)
		Print type$
		If type$ = "Token" Then
			'x = 46.84
			'y = 26.84
			x = 46
			y = 33
			Move XY(x, y, (Token_i * obj_h - 3), u, v, w) /1
			Token_i = Token_i - 1
			Call pick_stack
		ElseIf type$ = "Block" Then
			x = 22.5
			y = 22.5
			Move XY(x, y, (Block_i * obj_h - 3), u, v, w) /1
			Block_i = Block_i - 1
			Call pick_stack
        Else
			Print("Unknown type")
			Go XY(31, 24, 130, u, v, w) /1
			Exit Function
		EndIf
		Move XY(33, 24 + 5, 150, u, v, w) /1
		Move XY(33, 35, 100, u, v, w) /2
		Move XY(31, 35, (read_i * 6 - 5), u, v, w) /3
		Wait 0.5
		Off 8
		Wait 0.5
		Move XY(31, 35, 100, u, v, w) /3
	Next read_i
	Print "Finish stack"
	Go XY(31, 24, 130, u, v, w) /1
Fend
Function pick_stack
	CP Off
	TMove XY(0, 0, 1, 0)
	Wait 1
	On 8
	Wait .5
	TMove XY(0, 0, -1, 0)
	CP On
Fend
