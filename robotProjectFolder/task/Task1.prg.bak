Global Integer Token_c_UI, Block_c_UI
Boolean isMax_t, isMax_b, infeed_select
Integer append_i
Integer ListLen
Global Integer place_queue(5)
Global Boolean useGUI
'Momoery process
Global Integer mem_pla_arr(6)
Global Integer mem_infe_t_arr(3)
Global Integer mem_infe_b_arr(3)

Global Integer infeed_ti
Global Integer infeed_bi

Function Task1_Load(Sender$ As String)
	Token_c_UI = -1
	Block_c_UI = -1
	append_i = 0
	isMax_t = False
	isMax_b = False
	useGUI = False
	infeed_select = False
	Integer i, j, queue_i, mem_infe
	
	Call init_robot
	Xqt memory_process
	'初始化infeed選取清單
	For i = 0 To 3
		GSet Task1.COB_b.AddItem, Str$(i)
		GSet Task1.COB_t.AddItem, Str$(i)
	Next i
	
	'初始化放置列表
	For j = 0 To 5
		GSet Task1.existList.AddItem, "-1"
	Next j
	
	'初始化放置順序
	For queue_i = 0 To 5
		place_queue(queue_i) = -1
	Next
	
	'初始化記憶體
	mem_infe_t_arr(0) = 11; mem_infe_t_arr(1) = 12; mem_infe_t_arr(2) = 13;
	mem_infe_b_arr(0) = 14; mem_infe_b_arr(1) = 15; mem_infe_b_arr(2) = 16;
	For mem_infe = 0 To 2
		MemOn (mem_infe_t_arr(mem_infe))
		MemOn (mem_infe_b_arr(mem_infe))
	Next mem_infe
	mem_pla_arr(0) = 31; mem_pla_arr(1) = 32; mem_pla_arr(2) = 33
	mem_pla_arr(3) = 34; mem_pla_arr(4) = 35; mem_pla_arr(5) = 36
Fend
Function Task1_Closed(Sender$ As String)
	
Fend
Function Task1_CB_t1_Click(Sender$ As String)
	'Print "t1"
	checkState("Token")
	If Not isMax_t And infeed_select Then
		GSet Task1.existList.List(append_i), "Token"
		place_queue(append_i) = 0
		append_i = append_i + 1
	Else
		GSet Task1.CB_t1.Checked, False
	EndIf
Fend

