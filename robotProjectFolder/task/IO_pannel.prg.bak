Integer append_i
Integer limit_t
Integer limit_b
Global Boolean useGUI_stack
Function IO_pannel_Load(Sender$ As String)
	append_i = 0
	limit_t = 1
	limit_b = 1
	Integer init
	Double scale
	
	scale = 1
	Motor On
	Power High
	Speed 30 / scale
	Accel 30 / scale, 30 / scale
	SpeedS 500 / scale
	AccelS 5000 / scale
	Tool 1
	
	For init = 0 To 11
		GSet IO_pannel.append_list.AddItem, "-1"
	Next init
Fend
Function IO_pannel_SwitchIO_Click(Sender$ As String)
	Integer exist, openIndex, i
	'scan all memory and catch which one open is
	For i = 0 To 255
		exist = MemSw(i)
		If exist = 1 Then
			Exit For
		EndIf
	Next

	If exist = 0 Then
		openIndex = 0
	Else
		openIndex = i
	EndIf

	If exist = 1 Then
		MemOff openIndex
		MemOn (openIndex + 1)
	Else
		MemOn openIndex
	EndIf
	
Fend
Function IO_pannel_Token_Click(Sender$ As String)
	String check$
	If limit_t <= 6 Then
		GSet IO_pannel.append_list.List(append_i), "Token"
		
		Do
			GGet IO_pannel.append_list.List(append_i), check$
			If check$ = "Token" Then
				GSet IO_pannel.Token.Enabled, False
				GSet IO_pannel.Block.Enabled, False
				Exit Do
			EndIf
		Loop
		GSet IO_pannel.Token.Enabled, True
		GSet IO_pannel.Block.Enabled, True
		append_i = append_i + 1
		limit_t = limit_t + 1

	Else
		Print "Token is limit"
	EndIf
	
	If append_i = 12 Then
		Print "starting stack"
		useGUI_stack = True
		Call Main1
	EndIf
Fend

Function IO_pannel_Block_Click(Sender$ As String)
	String check$
	If limit_b <= 6 Then
		GSet IO_pannel.append_list.List(append_i), "Block"
		
		Do
			GGet IO_pannel.append_list.List(append_i), check$
			If check$ = "Block" Then
				GSet IO_pannel.Token.Enabled, False
				GSet IO_pannel.Block.Enabled, False
				Exit Do
			EndIf
		Loop
		GSet IO_pannel.Token.Enabled, True
		GSet IO_pannel.Block.Enabled, True
		append_i = append_i + 1
		limit_b = limit_b + 1
		Wait 0.5
	Else
		Print "Token is limit"
	EndIf

	If append_i = 12 Then
		Print "starting stack"
		useGUI_stack = True
		Call Main1
	EndIf
Fend
Function IO_pannel_Closed(Sender$ As String)
	'Home
Fend

Function IO_pannel_Run_Default_Click(Sender$ As String)
	Integer i
	For i = 0 To 11
		If (i Mod 2) = 1 Then
			GSet IO_pannel.append_list.List(i), "Block"
		Else
			GSet IO_pannel.append_list.List(i), "Token"
		EndIf
	Next
	useGUI_stack = False
	
	Call stack_task
Fend

